<section class="cham-contact">
  <div class="cham-shell cham-contact__grid">
    <div>
      <p class="cham-kicker">Liên hệ</p>
      <h1>Bạn muốn tìm hiểu thêm về CHẠM?</h1>
      <p class="cham-contact__intro">Bạn có thể thử biểu mẫu bên cạnh. Đây là tính năng minh họa, nội dung không được gửi đi hay lưu vào hệ thống.</p>
    </div>
    <div>
      <form class="cham-form" data-cham-contact-demo>
        <div class="cham-form__field"><label for="ChamContactName">Tên hiển thị</label><input id="ChamContactName" type="text" placeholder="Tên mẫu" maxlength="50" required></div>
        <div class="cham-form__field"><label for="ChamContactTopic">Chủ đề</label>
          <select id="ChamContactTopic" required><option value="Sản phẩm">Sản phẩm</option><option value="Trải nghiệm">Trải nghiệm website</option><option value="Khác">Khác</option></select>
        </div>
        <div class="cham-form__field cham-form__field--full"><label for="ChamContactBody">Nội dung minh họa</label><textarea id="ChamContactBody" maxlength="500" minlength="5" placeholder="Viết lời nhắn minh họa" required></textarea></div>
        <div class="cham-form__field cham-form__field--full"><button class="cham-button cham-button--primary" type="submit">Gửi thử</button></div>
        <p class="cham-form__message" data-cham-contact-result role="status" hidden>Đã hoàn thành thao tác thử. Không có tin nhắn nào được gửi.</p>
      </form>
    </div>
  </div>
</section>
{% schema %}
{"name":"CHẠM · Liên hệ","tag":"section","settings":[],"presets":[],"enabled_on":{"templates":["page"]}}
{% endschema %}