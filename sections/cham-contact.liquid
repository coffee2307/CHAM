<section class="cham-contact">
  <div class="cham-shell cham-contact__grid">
    <div>
      <p class="cham-kicker">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="cham-contact__intro">{{ section.settings.intro }}</p>
      <p class="cham-contact__intro">{{ section.settings.custom_note }}</p>
    </div>
    <div>
      {% form 'contact', class: 'cham-form' %}
        {% if form.posted_successfully? %}<div class="cham-form__message">CHẠM đã nhận được lời nhắn của bạn.</div>{% endif %}
        {% if form.errors %}<div class="cham-form__message">{{ form.errors | default_errors }}</div>{% endif %}
        <div class="cham-form__field"><label for="ChamContactName-{{ section.id }}">Tên</label><input id="ChamContactName-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name"></div>
        <div class="cham-form__field"><label for="ChamContactEmail-{{ section.id }}">Email</label><input id="ChamContactEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required></div>
        <div class="cham-form__field cham-form__field--full"><label for="ChamContactPhone-{{ section.id }}">Số điện thoại</label><input id="ChamContactPhone-{{ section.id }}" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
        <div class="cham-form__field cham-form__field--full"><label for="ChamContactBody-{{ section.id }}">Bạn đang cần gì?</label><textarea id="ChamContactBody-{{ section.id }}" name="contact[body]" required>{{ form.body }}</textarea></div>
        <div class="cham-form__field cham-form__field--full"><button class="cham-button cham-button--primary" type="submit">Gửi cho CHẠM</button></div>
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM · Liên hệ",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Dòng nhỏ","default":"LIÊN HỆ · TÙY CHỈNH"},
    {"type":"text","id":"heading","label":"Tiêu đề","default":"Kể CHẠM nghe bạn đang tìm gì."},
    {"type":"textarea","id":"intro","label":"Mô tả","default":"Hỏi về sản phẩm, vận chuyển, nguồn gốc, đơn quà tặng hoặc nhu cầu hợp tác."},
    {"type":"textarea","id":"custom_note","label":"Ghi chú tùy chỉnh","default":"Với đơn tùy chỉnh, hãy ghi rõ sản phẩm, số lượng, màu hoặc chất liệu mong muốn, kích thước và thời gian cần nhận nếu có."}
  ],
  "presets":[],"enabled_on":{"templates":["page"]}
}
{% endschema %}