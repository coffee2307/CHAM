{%- assign custom_link = section.settings.link | default: '/pages/contact' -%}
<section class="cham-section cham-custom-section">
  <div class="cham-shell">
    <div class="cham-custom">

      <div class="cham-custom__inner">

        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.body }}</p>
        <a class="cham-button" href="{{ custom_link }}">{{ section.settings.button_label }} </a>
      </div>
      <div class="cham-custom__aside">
        <span>GỢI Ý YÊU CẦU</span>
        <ul><li>Quà tặng doanh nghiệp</li><li>Kích thước và màu sắc</li><li>Đóng gói và nhãn riêng</li></ul>
        <small>Mỗi yêu cầu được xem xét theo năng lực sản xuất thực tế.</small>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM · Tùy chỉnh",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Dòng nhỏ","default":"ĐẶT THEO YÊU CẦU"},
    {"type":"text","id":"heading","label":"Tiêu đề","default":"Mỗi nhu cầu có thể bắt đầu từ một món đồ thủ công."},
    {"type":"textarea","id":"body","label":"Mô tả","default":"CHẠM tiếp nhận yêu cầu về kích thước, màu sắc, đóng gói quà và đơn đặt hàng doanh nghiệp. Khả năng thực hiện được xác nhận theo từng sản phẩm, vật liệu và cơ sở sản xuất."},
    {"type":"text","id":"button_label","label":"Nhãn nút","default":"Gửi yêu cầu"},
    {"type":"url","id":"link","label":"Liên kết"}
  ],
  "presets":[{"name":"CHẠM · Tùy chỉnh","category":"CHẠM"}]
}
{% endschema %}
