{%- liquid
  assign source_collection = section.settings.collection
  if source_collection == blank
    assign source_collection = collections.all
  endif
-%}
<section class="cham-section cham-featured-section">
  <div class="cham-shell">
    <div class="cham-section-head">
      <div><p class="cham-kicker">{{ section.settings.eyebrow }}</p><h2 class="cham-section-title">{{ section.settings.heading }}</h2></div>
      <a class="cham-pill" href="{{ source_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.view_all_label }}</a>
    </div>
    <div class="cham-product-grid">
      {% for product in source_collection.products limit: section.settings.product_limit %}
        <article class="cham-product-card">
          <a class="cham-product-card__media" href="{{ product.url }}">
            {% if product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '280, 460, 700, 900', sizes: '(max-width: 560px) 50vw, (max-width: 1100px) 33vw, 25vw', alt: product.featured_image.alt | default: product.title }}
            {% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
          </a>
          <div class="cham-product-card__body">
            <div class="cham-product-card__meta"><span>{{ product.type | default: 'Đồ đan' }}</span>{% if product.vendor != blank %}<span>{{ product.vendor }}</span>{% endif %}</div>
            <h3 class="cham-product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <div class="cham-product-card__price">{% if product.price_varies %}Từ {% endif %}{{ product.price | money }}</div>
            {% if product.tags contains 'custom' or product.tags contains 'Custom' or product.tags contains 'tuy-chinh' %}<span class="cham-badge">Có thể tùy chỉnh</span>{% endif %}
          </div>
        </article>
      {% else %}
        {% for i in (1..4) %}
          <article class="cham-product-card">
            <div class="cham-product-card__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
            <div class="cham-product-card__body"><div class="cham-product-card__meta"><span>Đồ đan</span></div><h3 class="cham-product-card__title">Sản phẩm mẫu {{ i }}</h3><div class="cham-product-card__price">—</div></div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM · Sản phẩm nổi bật",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Dòng nhỏ","default":"ĐỒ ĐAN ĐƯỢC CHỌN"},
    {"type":"text","id":"heading","label":"Tiêu đề","default":"Những món đan cho đời sống hằng ngày."},
    {"type":"collection","id":"collection","label":"Bộ sưu tập"},
    {"type":"range","id":"product_limit","label":"Số sản phẩm","min":4,"max":12,"step":1,"default":8},
    {"type":"text","id":"view_all_label","label":"Nhãn xem tất cả","default":"Xem tất cả"}
  ],
  "presets":[{"name":"CHẠM · Sản phẩm nổi bật","category":"CHẠM"}]
}
{% endschema %}