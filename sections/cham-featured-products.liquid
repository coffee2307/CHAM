    {"type":"collection","id":"collection","label":"Bá»™ sÆ°u táº­p"},
    {"type":"range","id":"product_limit","label":"Sá»‘ sáº£n pháº©m","min":4,"max":12,"step":1,"default":8},
    {"type":"text","id":"view_all_label","label":"NhĂ£n xem táº¥t cáº£","default":"Xem táº¥t cáº£"}
