{%- liquid
  assign source_collection = section.settings.collection
  if source_collection == blank
    assign source_collection = collections.all
  endif
-%}
<section class="cham-section cham-featured-section" data-cham-scroll>
  <div class="cham-shell">
    <div class="cham-section-head">
      <div><h2 class="cham-section-title">{{ section.settings.heading }}</h2><p class="cham-section-copy">{{ section.settings.body }}</p></div>
      <a class="cham-more-link" href="{{ source_collection.url | default: routes.all_products_collection_url }}">Xem tất cả</a>
    </div>
    <div class="cham-shop-grid">
      {% for product in source_collection.products limit: section.settings.product_limit %}
        {% render 'cham-shop-card', product: product %}
      {% else %}
        <p>CHẠM đang cập nhật danh sách sản phẩm.</p>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM · Sản phẩm nổi bật",
  "tag":"section",
  "settings":[
    {"type":"text","id":"heading","label":"Tiêu đề","default":"Sản phẩm được chọn"},
    {"type":"textarea","id":"body","label":"Mô tả ngắn","default":"Gốm, mây tre, vải dệt và những món quà nhỏ."},
    {"type":"collection","id":"collection","label":"Bộ sưu tập"},
    {"type":"range","id":"product_limit","label":"Số sản phẩm","min":4,"max":12,"step":1,"default":8}
  ],
  "presets":[{"name":"CHẠM · Sản phẩm nổi bật","category":"CHẠM"}]
}
{% endschema %}