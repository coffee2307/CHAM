{%- liquid
  assign products_source = collections.all
  assign card_limit = section.settings.products_limit | default: 6
-%}
<div class="cham5 cham5-market">
  {% render 'cham-collection-banner', variant: 'home' %}
  <div class="cham-home-curated">{% render 'cham-vietnam-culture' %}{% render 'cham-curated-catalog' %}{% render 'cham-gift-bundles' %}</div>
  <section class="cham5-categories" id="cham5-categories" aria-labelledby="cham5-categories-title">
    <div class="cham5-market__heading">
      <div><p class="cham5-eyebrow">Khám phá cửa hàng CHẠM</p><h2 id="cham5-categories-title">Khám phá danh mục.</h2></div>
      <a href="{{ routes.all_products_collection_url }}" class="cham5-textlink">Tất cả sản phẩm</a>
    </div>
    <div class="cham5-categories__grid">
      {% assign material_handles = 'xo-dua,gom,tre-may,luc-binh-co,go-soi-tu-nhien' | split: ',' %}
      {% for handle in material_handles %}
        {% assign group = collections[handle] %}{% if group != blank %}
          {%- liquid
            assign cover_handle = blank
            case group.handle
              when 'gom'
                assign cover_handle = 'am-tra-gom-tao-hinh'
              when 'go-soi-tu-nhien'
                assign cover_handle = 'bat-go'
              when 'luc-binh-co'
                assign cover_handle = 'tui-luc-binh'
              when 'tre-may'
                assign cover_handle = 'gio-may'
              when 'xo-dua'
                assign cover_handle = 'tham-chui-chan'
            endcase
            assign cover_product = all_products[cover_handle]
            assign photo = cover_product.featured_image | default: group.image | default: group.products.first.featured_image
          -%}
          <a class="cham5-category" href="{{ group.url }}" aria-label="Xem danh mục {{ group.title }}">
            <div class="cham5-category__image">
              {% if photo %}
                {{ photo | image_url: width: 1080 | image_tag: loading: 'lazy', decoding: 'async', widths: '360, 540, 760, 1080', sizes: '(max-width: 767px) 46vw, 30vw', alt: group.title }}
              {% endif %}
            </div>
            <div class="cham5-category__caption"><h3>{{ group.title }}</h3><small>{{ group.products_count }} sản phẩm</small></div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <section class="cham5-products" id="cham5-products" aria-labelledby="cham5-products-title">
    <div class="cham5-market__heading">
      <div><p class="cham5-eyebrow">Một số món đồ ở CHẠM</p><h2 id="cham5-products-title">Những lựa chọn dành cho đời sống.</h2></div>
      <a href="{{ routes.all_products_collection_url }}" class="cham5-textlink">Khám phá thêm</a>
    </div>
    <div class="cham5-products__grid">
      {% assign featured_handles = 'de-lot-ly-tron,mieng-cha-got-chan,bong-meo,xuong-cho,tham-chui-chan,ly-gom-men-xanh,gio-may,bat-go,tui-luc-binh,khay-tre-dan,chieu-coi,tui-soi-day' | split: ',' %}
      {% for handle in featured_handles limit: card_limit %}
        {% assign product = all_products[handle] %}
        <article class="cham5-product">
          <a href="{{ product.url }}" class="cham5-product__image" aria-label="Xem {{ product.title }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 960 | image_tag: loading: 'lazy', decoding: 'async', widths: '340, 520, 760, 960', sizes: '(max-width: 767px) 46vw, 30vw', alt: product.title }}
            {% endif %}
          </a>
          <div class="cham5-product__info">
            <a href="{{ product.url }}"><h3>{{ product.title }}</h3></a>
            <p>{{ product.price | money }}</p>
          </div>
        </article>
      {% else %}
        <p>CHẠM đang cập nhật sản phẩm.</p>
      {% endfor %}
    </div>
    <p class="cham5-products__notice">Sản phẩm và giá trên website phục vụ mục đích trình diễn, chưa có giao dịch thật.</p>
  </section>

  <nav class="cham5-further" aria-label="Khám phá thêm về CHẠM">
    <p class="cham5-eyebrow">Khám phá thêm</p>
    <a href="/pages/about">Về CHẠM</a>
    <a href="/pages/story">Câu chuyện CHẠM</a>
    <a href="/pages/cham-club">Hồ sơ thành viên</a>
  </nav>

  <section class="cham5-end" aria-labelledby="cham5-end-title">
    <div class="cham5-end__top"><p>Thủ công Việt Nam, theo một cách gần gũi hơn.</p><a href="#cham5-top">Lên đầu trang</a></div>
    <div class="cham5-end__main">
      <p class="cham5-eyebrow">Từ Việt Nam, bằng đôi tay.</p>
      <h2 id="cham5-end-title" aria-label="CHẠM"><span class="cham5-end__letter" aria-hidden="true">C</span><span class="cham5-end__letter" aria-hidden="true">H</span><span class="cham5-end__letter" aria-hidden="true">Ạ</span><span class="cham5-end__letter" aria-hidden="true">M</span></h2>
      <div class="cham5-end__sub"><p>Khám phá những giá trị được làm bằng tay.</p><a class="cham5-primary cham5-primary--light" href="{{ routes.all_products_collection_url }}">Khám phá sản phẩm</a></div>
    </div>
    <p class="cham5-end__legal">CHẠM là website trình diễn · Sản phẩm, điểm thưởng và đơn hàng đều là dữ liệu minh họa.</p>
  </section>
</div>
{% schema %}
{"name":"CHẠM · Cửa hàng","tag":"section","settings":[{"type":"range","id":"products_limit","label":"Số sản phẩm nổi bật","min":4,"max":12,"step":1,"default":6}],"presets":[{"name":"CHẠM · Cửa hàng","category":"CHẠM"}]}
{% endschema %}
