<section class="cham-section cham-section--paper cham-values-section">
  <div class="cham-shell">
    <div class="cham-section-head">
      <div><p class="cham-kicker">{{ section.settings.eyebrow }}</p><h2 class="cham-section-title">{{ section.settings.heading }}</h2></div>
      <p class="cham-section-copy">{{ section.settings.body }}</p>
    </div>
    <div class="cham-values">
      <article class="cham-value"><span class="cham-value__index">VẬT LIỆU</span><h3>Biết mình đang cầm thứ gì.</h3><p>Mỗi sản phẩm ưu tiên làm rõ vật liệu, đặc tính sử dụng, cách bảo quản và nguồn gốc khi dữ liệu từ cơ sở sản xuất có sẵn.</p></article>
      <article class="cham-value"><span class="cham-value__index">KỸ THUẬT</span><h3>Thấy được cách một món đồ thành hình.</h3><p>CHẠM không chỉ bán hình dáng cuối cùng. Kỹ thuật, cấu trúc và công đoạn hoàn thiện là một phần của câu chuyện sản phẩm.</p></article>
      <article class="cham-value"><span class="cham-value__index">ỨNG DỤNG</span><h3>Thủ công phải bước vào đời sống thật.</h3><p>Thiết kế được chọn theo khả năng sử dụng hằng ngày, từ đồ dùng, phụ kiện, trang trí đến quà tặng và nhu cầu tùy chỉnh.</p></article>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM · Giá trị",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Dòng nhỏ","default":"CÁCH CHẠM CHỌN SẢN PHẨM"},
    {"type":"text","id":"heading","label":"Tiêu đề","default":"Vật liệu rõ. Kỹ thuật thật. Dùng được lâu."},
    {"type":"textarea","id":"body","label":"Mô tả","default":"CHẠM tập trung vào những sản phẩm thủ công có câu chuyện, có công năng và có đủ thông tin để người mua hiểu mình đang chọn gì."}
  ],
  "presets":[{"name":"CHẠM · Giá trị","category":"CHẠM"}]
}
{% endschema %}