<section class="cham-gate">
  <div class="cham-gate__grain" aria-hidden="true"></div>
  <header class="cham-gate__top">
    <a class="cham-gate__brand" href="{{ routes.root_url }}" aria-label="CHẠM">CHẠM<span class="cham-gate__brand-dot">.</span></a>
    <span class="cham-gate__topnote">THỦ CÔNG VIỆT NAM <span aria-hidden="true">/</span> CHỌN LỌC CÓ TRÁCH NHIỆM</span>
  </header>
  <main class="cham-gate__main">
    <div class="cham-gate__copy">
      <p class="cham-gate__eyebrow"><span class="cham-gate__pulse"></span> MỘT KHÔNG GIAN MỚI ĐANG HÌNH THÀNH</p>
      <h1>Những điều<br>được làm <em>bằng tay.</em></h1>
      <p class="cham-gate__lead">CHẠM kết nối những sản phẩm thủ công Việt Nam với đời sống đương đại. Chúng tôi đang hoàn thiện một không gian để bạn khám phá sản phẩm, con người và câu chuyện phía sau.</p>
      <div class="cham-gate__rule"></div>
      <div class="cham-gate__bottom">
        <div><span class="cham-gate__label">TRẠNG THÁI</span><strong>Sắp ra mắt</strong></div>
        <div><span class="cham-gate__label">LĨNH VỰC</span><strong>Đồ thủ công Việt Nam</strong></div>
      </div>
      <details class="cham-gate__access" {% if section.settings.show_password_form %}open{% endif %}>
        <summary>Truy cập dành cho quản trị <span aria-hidden="true">↗</span></summary>
        {% form 'storefront_password' %}
          <label for="ChamGatePassword">Mật khẩu cửa hàng</label>
          <div class="cham-gate__inputrow">
            <input id="ChamGatePassword" type="password" name="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required {% if form.errors %}aria-invalid="true"{% endif %}>
            <button type="submit">Truy cập <span aria-hidden="true">→</span></button>
          </div>
          {% if form.errors %}<p class="cham-gate__error" role="alert">Mật khẩu chưa đúng. Vui lòng thử lại.</p>{% endif %}
        {% endform %}
      </details>
    </div>
    <div class="cham-gate__art" aria-hidden="true">
      <div class="cham-gate__art-caption">CHẠM <span>01 / KHỞI ĐẦU</span></div>
      <div class="cham-gate__disc cham-gate__disc--one"></div>
      <div class="cham-gate__disc cham-gate__disc--two"></div>
      <div class="cham-gate__disc cham-gate__disc--three"></div>
      <div class="cham-gate__art-center">C H Ạ M</div>
      <span class="cham-gate__art-bottom">VẬT LIỆU / BÀN TAY / ĐỜI SỐNG</span>
    </div>
  </main>
  <footer class="cham-gate__foot"><span>© {{ 'now' | date: '%Y' }} CHẠM</span><span>THỦ CÔNG CÓ CÂU CHUYỆN.</span></footer>
</section>
{% schema %}
{"name":"CHẠM · Trang chờ","settings":[{"type":"checkbox","id":"show_password_form","label":"Mở sẵn biểu mẫu mật khẩu","default":false}],"presets":[{"name":"CHẠM · Trang chờ"}]}
{% endschema %}