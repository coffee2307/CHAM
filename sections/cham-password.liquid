<div class="cham-lock"><div class="cham-lock__center"><h1>CHẠM</h1>{% form 'storefront_password' %}<label for="ChamPassword" class="cham-lock__sr">Mật khẩu cửa hàng</label><div class="cham-lock__field"><input id="ChamPassword" type="password" name="password" placeholder="Mật khẩu" autocomplete="current-password" required {% if form.errors %}aria-invalid="true"{% endif %}><button type="submit" aria-label="Truy cập cửa hàng">→</button></div>{% if form.errors %}<p class="cham-lock__error" role="alert">Mật khẩu không đúng.</p>{% endif %}{% endform %}</div></div>{% schema %}{"name":"CHẠM · Trang mật khẩu","settings":[],"presets":[{"name":"CHẠM · Trang mật khẩu"}]}{% endschema %}