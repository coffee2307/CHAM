{%- liquid
  assign product_source = section.settings.featured_collection | default: collections.all
  assign handles = 'gốm-trang-tri|may-tre-dan|vải-dệt-thủ-cong|phụ-kiện|qua-tặng' | split: '|'
  assign play_url = pages['cham-play'].url | default: '/pages/cham-play'
  assign club_url = pages['cham-club'].url | default: '/pages/cham-club'
-%}
<div class="cham6">
  <section class="cham6-catalog cham6-wrap" id="cham6-catalog" aria-labelledby="cham6-catalog-title" tabindex="-1">
    <div class="cham6-catalog__heading">
      <h2 id="cham6-catalog-title">Khám phá sản phẩm</h2>
      <a class="cham6-link" href="{{ routes.all_products_collection_url }}">Tất cả sản phẩm</a>
    </div>
    <ul class="cham6-categories" aria-label="Danh mục sản phẩm">
      {% for handle in handles %}
        {% assign group = collections[handle] %}
        {% if group != blank %}
          {% assign photo = group.image | default: group.products.first.featured_image %}
          <li>
            <a class="cham6-card" href="{{ group.url }}">
              {% if photo %}
                <div class="cham6-card__photo">
                  {{ photo | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '350, 550, 800, 1000', sizes: '(max-width: 700px) 46vw, 22vw', alt: '' }}
                </div>
              {% endif %}
              <span>{{ group.title | escape }}</span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
    <h3 class="cham6-catalog__subhead">Sản phẩm nổi bật</h3>
    <ul class="cham6-products">
      {% for product in product_source.products limit: section.settings.products_limit %}
        <li>
          <a class="cham6-card" href="{{ product.url }}">
            {% if product.featured_image %}
              <div class="cham6-card__photo">
                {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '350, 550, 800, 1000', sizes: '(max-width: 700px) 46vw, 28vw', alt: '' }}
              </div>
            {% endif %}
            <span>{{ product.title | escape }}</span>
            <small>{% if product.price_varies %}Từ {% endif %}{{ product.price | money }}{% unless product.available %} · Hết hàng{% endunless %}</small>
          </a>
        </li>
      {% else %}
        <li>CHẠM đang cập nhật sản phẩm.</li>
      {% endfor %}
    </ul>
    <p class="cham6-catalog__note">Sản phẩm và giá trên website phục vụ mục đích trình diễn. Cửa hàng chưa thực hiện giao dịch thật.</p>
  </section>

  <section class="cham6-play" aria-labelledby="cham6-play-title">
    <div class="cham6-play__inner cham6-wrap">
      <div class="cham6-play__copy">
        <h2 id="cham6-play-title">Học về nghề qua trò chơi</h2>
        <p>Chạy, nhảy và thu thập vật phẩm để mở câu hỏi về nghề truyền thống Việt Nam trong CHẠM Play. Xem hồ sơ và điểm thưởng ở CHẠM Club.</p>
        <div class="cham6-actions">
          <a class="cham6-button" href="{{ play_url }}">CHẠM Play</a>
          <a class="cham6-link" href="{{ club_url }}">CHẠM Club</a>
        </div>
      </div>
      <div class="cham6-play__sprite" aria-hidden="true">
        <img src="{{ 'cham-dino-idle.webp' | asset_url }}" width="2560" height="256" loading="lazy" alt="">
      </div>
    </div>
  </section>

  <section class="cham6-end" aria-labelledby="cham6-end-title">
    <div class="cham6-end__inner cham6-wrap">
      <div>
        <h2 id="cham6-end-title">CHẠM</h2>
        <p>Khám phá những giá trị được làm bằng tay.</p>
        <div class="cham6-actions">
          <a class="cham6-link" href="#cham6-catalog">Khám phá sản phẩm</a>
          <a class="cham6-link" href="{{ play_url }}">CHẠM Play</a>
        </div>
      </div>
      <img class="cham6-end__ink" src="{{ 'cham5-ink-bamboo.webp' | asset_url }}" width="514" height="900" loading="lazy" alt="">
    </div>
  </section>
</div>
{% schema %}
{
  "name": "CHẠM · Danh mục và kết",
  "limit": 1,
  "settings": [
    { "type": "collection", "id": "featured_collection", "label": "Bộ sưu tập sản phẩm nổi bật" },
    { "type": "range", "id": "products_limit", "label": "Số sản phẩm nổi bật", "min": 3, "max": 12, "step": 1, "default": 6 }
  ]
}
{% endschema %}
