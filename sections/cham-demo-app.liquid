<section class="cham-demo-app" aria-label="{{ section.settings.heading | escape }}">
  {% if section.settings.mode == 'club' or section.settings.mode == 'play' %}
    {% render 'cham-avatar-data' %}
  {% endif %}
  {% if section.settings.mode == 'play' %}
    <script type="application/json" id="cham-dino-assets">
      {
        "run": {{ 'cham-dino-run.webp' | asset_url | json }},
        "jump": {{ 'cham-dino-jump.webp' | asset_url | json }},
        "idle": {{ 'cham-dino-idle.webp' | asset_url | json }},
        "landscape": {{ 'cham-dino-landscape.svg' | asset_url | json }},
        "pottery": {{ 'cham-dino-pottery.svg' | asset_url | json }},
        "stump": {{ 'cham-dino-stump.svg' | asset_url | json }}
      }
    </script>
    <script type="application/json" id="cham-play-scenes">
      [
      {% assign has_photo = false %}
      {% for group in collections %}
        {% unless group.handle == 'frontpage' or group.handle == 'all' %}
          {% assign photo = group.image | default: group.products.first.featured_image %}
          {% if photo != blank %}
            {% if has_photo %},{% endif %}
            {{ photo | image_url: width: 1000 | json }}
            {% assign has_photo = true %}
          {% endif %}
        {% endunless %}
      {% endfor %}
      ]
    </script>
  {% endif %}
  <div data-cham-demo-app data-mode="{{ section.settings.mode | escape }}">
    <div class="cd-shell"><h1>{{ section.settings.heading }}</h1><p>Đang mở phiên trải nghiệm…</p></div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM · Ứng dụng demo",
  "tag":"section",
  "settings":[
    {"type":"text","id":"heading","label":"Tiêu đề dự phòng","default":"CHẠM Club"},
    {"type":"select","id":"mode","label":"Chức năng","options":[
      {"value":"club","label":"CHẠM Club · Hồ sơ"},
      {"value":"play","label":"CHẠM Play · Mini game"},
      {"value":"checkout","label":"Checkout mô phỏng"}
    ],"default":"club"}
  ],
  "presets":[{"name":"CHẠM · Ứng dụng demo","category":"CHẠM"}]
}
{% endschema %}
