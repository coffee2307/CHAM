<div class="cham6" data-cham6-story>
  <section class="cham6-hero cham6-wrap" id="cham6-top" aria-labelledby="cham6-title">
    <div class="cham6-hero__copy">
      <h1 id="cham6-title">CHẠM</h1>
      <p class="cham6-hero__lead">Nơi khám phá và mua sắm sản phẩm thủ công Việt Nam.</p>
      <p>Gốm, mây tre, vải dệt, phụ kiện và những món quà được chọn lọc. Khám phá sản phẩm và tìm hiểu câu chuyện phía sau những nghề thủ công.</p>
      <div class="cham6-actions">
        <a class="cham6-button" href="#cham6-catalog">Khám phá sản phẩm</a>
        <a class="cham6-link" href="#cham6-maker">Khám phá câu chuyện</a>
      </div>
    </div>
    <figure class="cham6-hero__media">
      {% render 'cham6-photo', asset: 'cham6-bat-trang-cover', width: 1600, height: 1200, alt: 'Người làm gốm ở Bát Tràng bên bàn xoay', hero: true %}
      <figcaption>Ảnh tư liệu tại Bát Tràng, Hà Nội</figcaption>
    </figure>
  </section>

  <section class="cham6-maker cham6-wrap" id="cham6-maker" aria-labelledby="cham6-maker-title">
    <figure class="cham6-maker__media" data-cham6-transition>
      {% render 'cham6-photo', asset: 'cham6-bat-trang-maker', width: 1600, height: 1200, alt: 'Người thợ Bát Tràng đang trang trí họa tiết trên phôi gốm' %}
    </figure>
    <div class="cham6-maker__copy">
      <h2 id="cham6-maker-title">Từ đôi tay người làm, đến món đồ bạn chọn.</h2>
      <p>Trước khi một chiếc bát đặt lên bàn, người làm gốm đã phải canh độ ẩm của đất, vuốt thành và sửa miệng bát. Chỉ một thay đổi nhỏ ở bàn xoay cũng làm chiếc bát cầm lên khác đi.</p>
      <a class="cham6-link" href="#cham6-making">Theo dõi cách làm gốm</a>
    </div>
  </section>

  <section class="cham6-making" id="cham6-making" data-cham6-making aria-labelledby="cham6-making-title">
    <div class="cham6-making__stage cham6-wrap" data-cham6-stage>
      <div class="cham6-making__heading">
        <h2 id="cham6-making-title">Từ đất đến gốm</h2>
        <p>Cách làm và thứ tự công đoạn thay đổi tùy xưởng, loại đất và kỹ thuật nung.</p>
      </div>
      <div class="cham6-making__viewport" data-cham6-viewport>
        <ol class="cham6-making__track" data-cham6-track>
          {% for block in section.blocks %}
            <li class="cham6-step" {{ block.shopify_attributes }}>
              {% if block.settings.photo != blank or block.settings.asset != blank %}
                <figure class="cham6-step__photo">
                  {%- assign photo_width = block.settings.asset_width | default: 1600 -%}
                  {%- assign photo_height = photo_width | times: 3 | divided_by: 4 -%}
                  {% render 'cham6-photo', image: block.settings.photo, asset: block.settings.asset, width: photo_width, height: photo_height, alt: block.settings.alt %}
                  {% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}
                </figure>
              {% endif %}
              <div class="cham6-step__copy">
                <h3>{{ block.settings.title | escape }}</h3>
                <p>{{ block.settings.description | escape }}</p>
              </div>
            </li>
          {% endfor %}
        </ol>
      </div>
      <div class="cham6-making__controls" data-cham6-controls hidden>
        <span class="cham6-making__meter" aria-hidden="true"><span></span></span>
        <p class="cham6-making__counter" aria-live="off"><span data-cham6-current>1</span> / {{ section.blocks.size }}</p>
        <button type="button" data-cham6-direction="-1" aria-label="Công đoạn trước">←</button>
        <button type="button" data-cham6-direction="1" aria-label="Công đoạn tiếp theo">→</button>
      </div>
    </div>
  </section>

  <section class="cham6-life cham6-wrap" aria-labelledby="cham6-life-title">
    <div class="cham6-life__copy">
      <h2 id="cham6-life-title">Đồ thủ công trong đời sống</h2>
      <p>Từ bát gốm trên bàn ăn đến giỏ mây trong nhà, mỗi món đồ có một công dụng riêng. CHẠM còn giới thiệu vải dệt, phụ kiện và quà tặng để bạn lựa chọn theo nhu cầu.</p>
      <a class="cham6-link" href="#cham6-catalog">Tìm theo danh mục</a>
    </div>
    {%- assign weave = collections['may-tre-dan'] -%}
    {%- assign weave_photo = weave.image | default: weave.products.first.featured_image -%}
    {% if weave_photo != blank %}
      <figure class="cham6-life__media">
        {{ weave_photo | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 750, 1000, 1200', sizes: '(max-width: 700px) 92vw, 54vw', alt: weave.title }}
        <figcaption>Ảnh sản phẩm từ danh mục {{ weave.title | escape }}</figcaption>
      </figure>
    {% endif %}
    {% render 'cham6-photo-credits' %}
  </section>
</div>
{% schema %}
{
  "name": "CHẠM · Câu chuyện",
  "limit": 1,
  "max_blocks": 6,
  "blocks": [
    {
      "type": "craft_step",
      "name": "Công đoạn làm gốm",
      "settings": [
        { "type": "text", "id": "title", "label": "Tiêu đề" },
        { "type": "textarea", "id": "description", "label": "Mô tả" },
        { "type": "image_picker", "id": "photo", "label": "Ảnh thay thế (đã xác minh quyền sử dụng)" },
        { "type": "text", "id": "asset", "label": "Tệp ảnh tư liệu mặc định" },
        { "type": "number", "id": "asset_width", "label": "Chiều rộng ảnh tư liệu", "default": 1600 },
        { "type": "text", "id": "alt", "label": "Mô tả ảnh cho trình đọc màn hình" },
        { "type": "text", "id": "caption", "label": "Chú thích và địa điểm chụp" }
      ]
    }
  ]
}
{% endschema %}
