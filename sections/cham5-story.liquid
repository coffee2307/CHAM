              <div class="cham7-process__details">
                <figure class="cham7-process__detail"><img src="{{ 'cham6-craft-decoration-640.webp' | asset_url }}" width="640" height="480" loading="lazy" decoding="async" alt="Công đoạn xử lý bề mặt"></figure>
                <figure class="cham7-process__detail"><img src="{{ 'cham6-craft-use-640.webp' | asset_url }}" width="640" height="480" loading="lazy" decoding="async" alt="Đồ gốm trong đời sống"></figure>
              </div>
            </div>
            <figure class="cham5-process__photo">
              <img src="{{ 'cham6-craft-kiln.webp' | asset_url }}"
