                <figure class="cham7-process__detail"><img src="{{ 'cham6-craft-kiln-640.webp' | asset_url }}" width="640" height="480" loading="lazy" decoding="async" alt="Lò nung gốm truyền thống"></figure>
              </div>
            </div>
            <figure class="cham5-process__photo">
              <img src="{{ 'cham6-craft-decoration.webp' | asset_url }}"
