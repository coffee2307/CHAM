<section class="cham-shop-page cham-shell" data-cham-shop>
  <div class="cham-shop-page__heading">
    <div>
      <p class="cham-shop-page__eyebrow">CHẠM</p>
      <h1>{% if collection.handle == 'all' %}Tất cả sản phẩm{% else %}{{ collection.title }}{% endif %}</h1>
      <p>Khám phá những vật dụng thủ công dành cho không gian sống và mỗi ngày.</p>
    </div>
    <span class="cham-shop-page__total" data-cham-live-count aria-live="polite">{{ collection.products_count }} sản phẩm</span>
  </div>
  {% if collection.handle == 'all' %}
    {% render 'cham-coir-feature' %}{% render 'cham-vietnam-culture' %}
    <details class="cham-curated-disclosure" open><summary>Bộ sưu tập và dịch vụ</summary>{% render 'cham-curated-catalog' %}{% render 'cham-gift-bundles' %}</details>
  {% else %}<div class="cham-collection-description">{{ collection.description }}</div><a class="cham-collection-back" href="{{ routes.all_products_collection_url }}">Tất cả bộ sưu tập và sản phẩm</a>{% endif %}
  <span class="cham-shop-page__filter-label">Theo chất liệu</span><nav class="cham-shop-page__tabs" aria-label="Danh mục sản phẩm">
    <a href="{{ routes.all_products_collection_url }}" {% if collection.handle == 'all' %}aria-current="page"{% endif %}>Tất cả</a>
    {% assign material_handles = 'xo-dua,gom,tre-may,luc-binh-co,go-soi-tu-nhien' | split: ',' %}
    {% for handle in material_handles %}{% assign group = collections[handle] %}{% if group != blank %}
      <a href="{{ group.url }}" {% if group.handle == collection.handle %}aria-current="page"{% endif %}>{{ group.title }}</a>
    {% endif %}{% endfor %}
  </nav>
  <div class="cham-shop-page__uses" aria-label="Lọc theo công dụng"><span class="cham-shop-page__filter-label">Theo công dụng</span><div class="cham-shop-page__use-items"><button type="button" data-cham-use="all" aria-pressed="true">Tất cả</button><button type="button" data-cham-use="tableware" aria-pressed="false">Bàn ăn</button><button type="button" data-cham-use="tea" aria-pressed="false">Trà và đồ uống</button><button type="button" data-cham-use="kitchen" aria-pressed="false">Nhà bếp</button><button type="button" data-cham-use="decor" aria-pressed="false">Trang trí và nội thất</button><button type="button" data-cham-use="storage" aria-pressed="false">Lưu trữ</button><button type="button" data-cham-use="fashion" aria-pressed="false">Túi và phụ kiện</button><button type="button" data-cham-use="care" aria-pressed="false">Chăm sóc cá nhân</button><button type="button" data-cham-use="pets" aria-pressed="false">Thú cưng</button></div></div>
  <div class="cham-shop-page__toolbar">
    <label class="cham-shop-page__search">
      <span class="visually-hidden">Tìm trong danh mục</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
      <input type="search" data-cham-filter-search placeholder="Tìm theo tên sản phẩm" autocomplete="off">
    </label>
    <label class="cham-shop-page__select"><span class="visually-hidden">Khoảng giá</span>
      <select data-cham-filter-price aria-label="Lọc theo giá">
        <option value="all">Mọi mức giá</option><option value="0-49999">Dưới 50.000đ</option><option value="50000-99999">50.000–99.999đ</option><option value="100000-199999">100.000–199.999đ</option><option value="200000-299999">200.000–299.999đ</option><option value="300000-499999">300.000–499.999đ</option><option value="500000-999999999">Từ 500.000đ</option><option value="200000-999999999">Từ 200.000đ</option>
      </select>
    </label>
    <label class="cham-shop-page__select"><span class="visually-hidden">Sắp xếp</span>
      <select data-cham-filter-sort aria-label="Sắp xếp sản phẩm">
        <option value="featured">Đề xuất</option><option value="low">Giá tăng dần</option><option value="high">Giá giảm dần</option><option value="name">Theo tên</option>
      </select>
    </label>
  </div>
  {% paginate collection.products by 50 %}
    <div class="cham-shop-grid cham-shop-grid--collection" data-cham-shop-grid data-cham-pages="{{ paginate.pages }}" data-cham-page="{{ paginate.current_page }}" data-cham-page-param="{{ paginate.page_param }}" data-cham-section-id="{{ section.id }}" data-cham-total="{{ collection.products_count }}">
      {% for item in collection.products %}
        {% render 'cham-shop-card', product: item %}
      {% else %}
        <p class="cham-shop-page__empty">Chưa có sản phẩm trong danh mục này.</p>
      {% endfor %}
    </div>
    <p class="cham-shop-page__load-state" data-cham-load-state role="status" hidden></p>
    <div class="cham-shop-page__empty" data-cham-no-matches hidden>Không tìm thấy sản phẩm phù hợp. <button type="button" data-cham-reset-filters>Xóa bộ lọc</button></div>
    {% if paginate.pages > 1 %}
      <nav class="cham-shop-page__pagination" aria-label="Trang kết quả">{{ paginate | default_pagination }}</nav>
    {% endif %}
  {% endpaginate %}
</section>
{% schema %}
{"name":"CHẠM · Cửa hàng","tag":"section","settings":[],"presets":[],"enabled_on":{"templates":["collection"]}}
{% endschema %}