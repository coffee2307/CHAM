{%- liquid
  assign cham_story_page = pages['story'] | default: pages['cau-chuyen']
  assign cham_story_url = '/pages/about#story'
  if cham_story_page != blank
    assign cham_story_url = cham_story_page.url
  endif
-%}
<section class="cham-footer">
  <div class="cham-shell">
    <div class="cham-footer__marquee" aria-hidden="true"><span>LÀM · CHẠM · DÙNG · GIỮ ·</span><span>LÀM · CHẠM · DÙNG · GIỮ ·</span></div>
    <div class="cham-footer__grid">
      <div class="cham-footer__brand-wrap">
        <div class="cham-footer__brand">{{ section.settings.wordmark | default: 'CHẠM' }}</div>
        <p class="cham-footer__tagline">{{ section.settings.tagline }}</p>
      </div>
      <div>
        <p class="cham-footer__heading">Khám phá</p>
        <ul class="cham-footer__menu" role="list">
          <li><a href="{{ routes.root_url }}">Trang chủ</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Tất cả sản phẩm</a></li>
          <li><a href="{{ cham_story_url }}">Câu chuyện CHẠM</a></li>
          <li><a href="/pages/about">Về CHẠM</a></li>
          <li><a href="/pages/cham-club">CHẠM Club</a></li>
          <li><a href="/pages/cham-play">CHẠM Play</a></li>
          <li><a href="/pages/faq">Hỏi đáp</a></li>
        </ul>
      </div>
      <div>
        <p class="cham-footer__heading">Hỗ trợ</p>
        <ul class="cham-footer__menu" role="list">
          <li><a href="/pages/contact">Liên hệ</a></li>
          <li><a href="/policies/shipping-policy">Vận chuyển</a></li>
          <li><a href="/policies/refund-policy">Đổi trả</a></li>
        </ul>
      </div>
      <div class="cham-footer__newsletter">
        <p class="cham-footer__heading">{{ section.settings.newsletter_heading }}</p>
        <p class="cham-footer__tagline">{{ section.settings.newsletter_text }}</p>
        <a class="cham-button cham-button--primary" href="/pages/cham-club">Trải nghiệm CHẠM Club</a>
        <small>Website demo không thu thập email đăng ký nhận tin.</small>
      </div>
    </div>
    <div class="cham-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ section.settings.wordmark | default: 'CHẠM' }}.</span>
      <span>{{ section.settings.bottom_note }}</span>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM · Cuối trang",
  "tag":"section",
  "class":"cham-footer-section",
  "settings":[
    {"type":"text","id":"wordmark","label":"Tên thương hiệu","default":"CHẠM"},
    {"type":"textarea","id":"tagline","label":"Giới thiệu ngắn","default":"Đồ thủ công Việt Nam cho đời sống đương đại — rõ câu chuyện, rõ giá trị và có thể tùy chỉnh."},
    {"type":"text","id":"newsletter_heading","label":"Tiêu đề nhận tin","default":"Nhận tin từ CHẠM"},
    {"type":"textarea","id":"newsletter_text","label":"Mô tả nhận tin","default":"Sản phẩm mới, câu chuyện người làm và các đợt mở tùy chỉnh."},
    {"type":"text","id":"bottom_note","label":"Ghi chú cuối trang","default":"Thủ công Việt Nam · Chọn lọc có trách nhiệm · Tùy chỉnh theo nhu cầu"}
  ],
  "presets":[{"name":"CHẠM · Cuối trang","category":"Cuối trang"}],
  "enabled_on":{"groups":["footer"]}
}
{% endschema %}