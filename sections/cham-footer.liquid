{%- liquid
  assign menu_primary = section.settings.menu_primary
  assign menu_secondary = section.settings.menu_secondary
-%}
<section class="cham-footer">
  <div class="cham-shell">
    <div class="cham-footer__grid">
      <div class="cham-footer__brand-wrap">
        <div class="cham-footer__brand">{{ section.settings.wordmark | default: 'CHẠM' }}</div>
        <p class="cham-footer__tagline">{{ section.settings.tagline }}</p>
      </div>
      <div>
        <p class="cham-footer__heading">{{ section.settings.menu_primary_heading }}</p>
        <ul class="cham-footer__menu" role="list">
          {% if menu_primary != blank %}
            {% for link in menu_primary.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
          {% else %}
            <li><a href="{{ routes.all_products_collection_url }}">Tất cả sản phẩm</a></li>
            <li><a href="/pages/story">Câu chuyện CHẠM</a></li>
            <li><a href="/pages/about">Về CHẠM</a></li>
          {% endif %}
        </ul>
      </div>
      <div>
        <p class="cham-footer__heading">{{ section.settings.menu_secondary_heading }}</p>
        <ul class="cham-footer__menu" role="list">
          {% if menu_secondary != blank %}
            {% for link in menu_secondary.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
          {% else %}
            <li><a href="/pages/contact">Liên hệ</a></li>
            <li><a href="/policies/shipping-policy">Vận chuyển</a></li>
            <li><a href="/policies/refund-policy">Đổi trả</a></li>
          {% endif %}
        </ul>
      </div>
      <div class="cham-footer__newsletter">
        <p class="cham-footer__heading">{{ section.settings.newsletter_heading }}</p>
        <p class="cham-footer__tagline">{{ section.settings.newsletter_text }}</p>
        {% form 'customer', class: 'cham-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="ChamNewsletter-{{ section.id }}">Email</label>
          <input id="ChamNewsletter-{{ section.id }}" type="email" name="contact[email]" placeholder="Email của bạn" autocomplete="email" required>
          <button type="submit">Đăng ký</button>
        {% endform %}
      </div>
    </div>
    <div class="cham-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ section.settings.wordmark | default: 'CHẠM' }}.</span>
      <span>{{ section.settings.bottom_note }}</span>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM Footer",
  "tag":"section",
  "class":"cham-footer-section",
  "settings":[
    {"type":"text","id":"wordmark","label":"Wordmark","default":"CHẠM"},
    {"type":"textarea","id":"tagline","label":"Tagline","default":"Đồ đan thủ công Việt Nam cho đời sống đương đại — rõ vật liệu, rõ kỹ thuật và có thể tùy chỉnh."},
    {"type":"text","id":"menu_primary_heading","label":"Tiêu đề menu 1","default":"Khám phá"},
    {"type":"link_list","id":"menu_primary","label":"Menu 1","default":"footer"},
    {"type":"text","id":"menu_secondary_heading","label":"Tiêu đề menu 2","default":"Hỗ trợ"},
    {"type":"link_list","id":"menu_secondary","label":"Menu 2"},
    {"type":"text","id":"newsletter_heading","label":"Tiêu đề newsletter","default":"Nhận tin từ CHẠM"},
    {"type":"textarea","id":"newsletter_text","label":"Mô tả newsletter","default":"Sản phẩm đan mới, câu chuyện vật liệu và các đợt mở custom."},
    {"type":"text","id":"bottom_note","label":"Ghi chú cuối trang","default":"Đồ đan Việt Nam · Vật liệu tự nhiên · Custom theo nhu cầu"}
  ],
  "presets":[{"name":"CHẠM Footer","category":"Footer"}],
  "enabled_on":{"groups":["footer"]}
}
{% endschema %}
