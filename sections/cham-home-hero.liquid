{%- liquid
  assign primary_link = section.settings.primary_link | default: routes.all_products_collection_url
  assign story_page = pages['story'] | default: pages['cau-chuyen']
  assign story_url = '/pages/about'
  if story_page != blank
    assign story_url = story_page.url
  endif
  assign secondary_link = section.settings.secondary_link | default: story_url
  assign hero_image = section.settings.image
  if hero_image == blank
    assign hero_image = collections.all.products.first.featured_image
  endif
-%}
<section class="cham-hero cham-hero--signature cham-hero--minimal{% if hero_image == blank %} cham-hero--text-only{% endif %}" data-cham-hero>
  <div class="cham-shell cham-hero__grid">
    <div class="cham-hero__copy">
      <p class="cham-kicker">{{ section.settings.eyebrow }}</p>
      <h1 class="cham-hero__title">{{ section.settings.heading | escape | newline_to_br }}</h1>
      <div class="cham-hero__body">{{ section.settings.body }}</div>
      <div class="cham-hero__actions">
        <a class="cham-button cham-button--primary" href="{{ primary_link }}">{{ section.settings.primary_label }}</a>
        <a class="cham-hero__story-link" href="{{ secondary_link }}">{{ section.settings.secondary_label }} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    {% if hero_image != blank %}
      <figure class="cham-hero__figure">
        <div class="cham-hero__visual cham-hero__visual--signature cham-hero__visual--photo">
          {{ hero_image | image_url: width: 1440 | image_tag: loading: 'eager', widths: '400, 600, 800, 1100, 1440', sizes: '(max-width: 860px) 90vw, 46vw', alt: hero_image.alt | default: 'Sản phẩm thủ công minh họa tại CHẠM' }}
        </div>
      </figure>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name":"CHẠM · Mở đầu",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Dòng nhỏ","default":"ĐỒ THỦ CÔNG VIỆT NAM"},
    {"type":"textarea","id":"heading","label":"Tiêu đề","default":"Thủ công Việt,\ncho mỗi ngày."},
    {"type":"richtext","id":"body","label":"Mô tả","default":"<p>Gốm, mây tre, vải dệt và những món quà được chọn cho đời sống hôm nay.</p>"},
    {"type":"text","id":"primary_label","label":"Nút chính","default":"Xem sản phẩm"},
    {"type":"url","id":"primary_link","label":"Liên kết nút chính"},
    {"type":"text","id":"secondary_label","label":"Nút phụ","default":"Về CHẠM"},
    {"type":"url","id":"secondary_link","label":"Liên kết nút phụ"},
    {"type":"image_picker","id":"image","label":"Ảnh mở đầu"}
  ],
  "presets":[{"name":"CHẠM · Mở đầu","category":"CHẠM"}]
}
{% endschema %}
