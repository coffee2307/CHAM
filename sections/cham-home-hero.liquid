{%- liquid
  assign primary_link = section.settings.primary_link | default: routes.all_products_collection_url
  assign secondary_link = section.settings.secondary_link | default: '/pages/about#story'
-%}
<section class="cham-hero cham-hero--signature" data-cham-hero>
  <div class="cham-shell cham-hero__grid">
    <div class="cham-hero__copy" data-cham-reveal>
      <div class="cham-hero__eyebrow-row">
        <p class="cham-kicker">{{ section.settings.eyebrow }}</p>
        <span class="cham-hero__edition">THỦ CÔNG VIỆT NAM</span>
      </div>
      <h1 class="cham-hero__title">{{ section.settings.heading }}</h1>
      <div class="cham-hero__body">{{ section.settings.body }}</div>
      <div class="cham-hero__actions">
        <a class="cham-button cham-button--primary" href="{{ primary_link }}"><span>{{ section.settings.primary_label }}</span><span aria-hidden="true">↗</span></a>
        <a class="cham-button cham-button--soft" href="{{ secondary_link }}"><span>{{ section.settings.secondary_label }}</span></a>
      </div>

      {% if section.settings.show_search %}
        <form class="cham-search" action="{{ routes.search_url }}" method="get" role="search">
          <span class="cham-search__mark" aria-hidden="true">⌕</span>
          <label class="visually-hidden" for="ChamHeroSearch-{{ section.id }}">Tìm sản phẩm thủ công</label>
          <input id="ChamHeroSearch-{{ section.id }}" type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" autocomplete="off">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit">Tìm</button>
        </form>
      {% endif %}

      <div class="cham-hero__chips" aria-label="Khám phá sản phẩm">
        <a href="{{ routes.all_products_collection_url }}">Trang trí</a>
        <a href="{{ routes.all_products_collection_url }}">Phụ kiện</a>
        <a href="{{ routes.all_products_collection_url }}">Đồ dùng</a>
        <a href="{{ routes.all_products_collection_url }}">Quà tặng</a>
      </div>
    </div>

    <div class="cham-hero__visual cham-craft-visual cham-hero__visual--signature" data-cham-tilt aria-label="Thủ công Việt Nam">
      <div class="cham-hero__halo" aria-hidden="true"></div>
      {% if section.settings.image != blank %}
        <div class="cham-hero__image">
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200, 1400', sizes: '(max-width: 820px) 100vw, 48vw', alt: section.settings.image.alt }}
        </div>
      {% elsif collections.all.products.first.featured_image != blank %}
        <div class="cham-hero__image">
          {{ collections.all.products.first.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200, 1400', sizes: '(max-width: 820px) 100vw, 48vw', alt: collections.all.products.first.title }}
        </div>
      {% else %}
        <div class="cham-craft-sculpture" aria-hidden="true">
          <div class="cham-craft-sculpture__shape cham-craft-sculpture__shape--one"></div>
          <div class="cham-craft-sculpture__shape cham-craft-sculpture__shape--two"></div>
          <div class="cham-craft-sculpture__shape cham-craft-sculpture__shape--three"></div>
          <div class="cham-craft-sculpture__label cham-craft-sculpture__label--a"><b>VẬT LIỆU</b><span>tự nhiên · có câu chuyện</span></div>
          <div class="cham-craft-sculpture__label cham-craft-sculpture__label--b"><b>BÀN TAY</b><span>kỹ thuật · kinh nghiệm</span></div>
          <div class="cham-craft-sculpture__label cham-craft-sculpture__label--c"><b>ĐỜI SỐNG</b><span>dùng được · bền lâu</span></div>
        </div>
      {% endif %}
      <div class="cham-hero__seal" aria-hidden="true"><span>CHẠM</span><small>THỦ CÔNG VIỆT NAM</small></div>
      <div class="cham-hero__note cham-hero__note--top">VẬT LIỆU · TAY · CÂU CHUYỆN</div>
      <div class="cham-hero__note cham-hero__note--bottom">THỦ CÔNG CHO ĐỜI SỐNG</div>
    </div>
  </div>

  <div class="cham-material-strip" aria-hidden="true">
    <div class="cham-material-strip__track">
      <span>THỦ CÔNG</span><i>•</i><span>CHỌN LỌC</span><i>•</i><span>MINH BẠCH</span><i>•</i><span>TÙY CHỈNH</span><i>•</i><span>VĂN HÓA</span><i>•</i><span>ĐỜI SỐNG</span><i>•</i>
      <span>THỦ CÔNG</span><i>•</i><span>CHỌN LỌC</span><i>•</i><span>MINH BẠCH</span><i>•</i><span>TÙY CHỈNH</span><i>•</i><span>VĂN HÓA</span><i>•</i><span>ĐỜI SỐNG</span><i>•</i>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM · Mở đầu",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Dòng nhỏ","default":"ĐỒ THỦ CÔNG VIỆT NAM · CHỌN LỌC"},
    {"type":"textarea","id":"heading","label":"Tiêu đề","default":"Chạm vào những điều được làm bằng tay."},
    {"type":"richtext","id":"body","label":"Mô tả","default":"<p>CHẠM chọn lọc đồ thủ công Việt Nam cho đời sống hiện đại — dễ tiếp cận, rõ câu chuyện và vẫn giữ được dấu vết của bàn tay làm ra chúng.</p>"},
    {"type":"text","id":"primary_label","label":"Nút chính","default":"Khám phá đồ thủ công"},
    {"type":"url","id":"primary_link","label":"Liên kết nút chính"},
    {"type":"text","id":"secondary_label","label":"Nút phụ","default":"Câu chuyện CHẠM"},
    {"type":"url","id":"secondary_link","label":"Liên kết nút phụ"},
    {"type":"checkbox","id":"show_search","label":"Hiện ô tìm kiếm","default":true},
    {"type":"text","id":"search_placeholder","label":"Gợi ý tìm kiếm","default":"Tìm đồ trang trí, phụ kiện, quà tặng..."},
    {"type":"image_picker","id":"image","label":"Ảnh mở đầu"}
  ],
  "presets":[{"name":"CHẠM · Mở đầu","category":"CHẠM"}]
}
{% endschema %}