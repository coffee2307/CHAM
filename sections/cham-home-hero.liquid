{%- liquid
  assign primary_link = section.settings.primary_link | default: routes.all_products_collection_url
  assign secondary_link = section.settings.secondary_link | default: '/pages/story'
-%}
<section class="cham-hero cham-hero--weave" data-cham-hero>
  <div class="cham-shell cham-hero__grid">
    <div class="cham-hero__copy" data-cham-reveal>
      <div class="cham-hero__eyebrow-row">
        <p class="cham-kicker">{{ section.settings.eyebrow }}</p>
        <span class="cham-hero__edition">VIETNAM / WOVEN CRAFT</span>
      </div>
      <h1 class="cham-hero__title">{{ section.settings.heading }}</h1>
      <div class="cham-hero__body">{{ section.settings.body }}</div>
      <div class="cham-hero__actions">
        <a class="cham-button cham-button--primary" href="{{ primary_link }}"><span>{{ section.settings.primary_label }}</span><span aria-hidden="true">↗</span></a>
        <a class="cham-button cham-button--soft" href="{{ secondary_link }}"><span>{{ section.settings.secondary_label }}</span></a>
      </div>

      {% if section.settings.show_search %}
        <form class="cham-search" action="{{ routes.search_url }}" method="get" role="search">
          <span class="cham-search__mark" aria-hidden="true">⌕</span>
          <label class="visually-hidden" for="ChamHeroSearch-{{ section.id }}">Tìm sản phẩm đan</label>
          <input id="ChamHeroSearch-{{ section.id }}" type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" autocomplete="off">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit">Tìm</button>
        </form>
      {% endif %}

      <div class="cham-hero__chips" aria-label="Chất liệu đan">
        <a href="{{ routes.all_products_collection_url }}">Mây</a>
        <a href="{{ routes.all_products_collection_url }}">Tre</a>
        <a href="{{ routes.all_products_collection_url }}">Cói</a>
        <a href="{{ routes.all_products_collection_url }}">Lục bình</a>
      </div>
    </div>

    <div class="cham-hero__visual cham-weave-visual" data-cham-tilt aria-label="Kỹ nghệ đan thủ công Việt Nam">
      <div class="cham-hero__halo" aria-hidden="true"></div>
      {% if section.settings.image != blank %}
        <div class="cham-hero__image">
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200, 1400', sizes: '(max-width: 820px) 100vw, 48vw', alt: section.settings.image.alt }}
        </div>
      {% else %}
        <div class="cham-weave-demo" aria-hidden="true">
          <div class="cham-weave-demo__ring"></div>
          <div class="cham-weave-demo__card cham-weave-demo__card--a"><span>01</span><strong>Mây</strong><em>dẻo / nhẹ</em></div>
          <div class="cham-weave-demo__card cham-weave-demo__card--b"><span>02</span><strong>Tre</strong><em>chắc / bền</em></div>
          <div class="cham-weave-demo__card cham-weave-demo__card--c"><span>03</span><strong>Cói</strong><em>mềm / mộc</em></div>
          <div class="cham-weave-demo__card cham-weave-demo__card--d"><span>04</span><strong>Lục bình</strong><em>ấm / tự nhiên</em></div>
        </div>
      {% endif %}
      <div class="cham-hero__seal" aria-hidden="true"><span>CHẠM</span><small>WOVEN IN VIETNAM</small></div>
      <div class="cham-hero__note cham-hero__note--top">FIBRE / HAND / FORM</div>
      <div class="cham-hero__note cham-hero__note--bottom">WOVEN OBJECTS FOR DAILY LIFE</div>
    </div>
  </div>

  <div class="cham-material-strip" aria-hidden="true">
    <div class="cham-material-strip__track">
      <span>MÂY</span><i>•</i><span>TRE</span><i>•</i><span>CÓI</span><i>•</i><span>LỤC BÌNH</span><i>•</i><span>ĐAN NAN</span><i>•</i><span>ĐAN MẮT CÁO</span><i>•</i>
      <span>MÂY</span><i>•</i><span>TRE</span><i>•</i><span>CÓI</span><i>•</i><span>LỤC BÌNH</span><i>•</i><span>ĐAN NAN</span><i>•</i><span>ĐAN MẮT CÁO</span><i>•</i>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM Hero",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Dòng nhỏ","default":"ĐỒ ĐAN THỦ CÔNG VIỆT NAM · CHỌN LỌC"},
    {"type":"textarea","id":"heading","label":"Tiêu đề","default":"Đan những điều gần gũi vào đời sống hôm nay."},
    {"type":"richtext","id":"body","label":"Mô tả","default":"<p>CHẠM tập trung vào các sản phẩm đan từ mây, tre, cói, lục bình và sợi tự nhiên — được chọn để dễ dùng, dễ mua và vẫn giữ được dấu vết của bàn tay làm ra chúng.</p>"},
    {"type":"text","id":"primary_label","label":"Nút chính","default":"Khám phá đồ đan"},
    {"type":"url","id":"primary_link","label":"Link nút chính"},
    {"type":"text","id":"secondary_label","label":"Nút phụ","default":"Câu chuyện CHẠM"},
    {"type":"url","id":"secondary_link","label":"Link nút phụ"},
    {"type":"checkbox","id":"show_search","label":"Hiện ô tìm kiếm","default":true},
    {"type":"text","id":"search_placeholder","label":"Placeholder tìm kiếm","default":"Tìm giỏ mây, túi cói, khay tre, đồ lưu trữ..."},
    {"type":"image_picker","id":"image","label":"Ảnh hero (không bắt buộc)"}
  ],
  "presets":[{"name":"CHẠM Hero","category":"CHẠM"}]
}
{% endschema %}
