{%- assign category_limit = section.settings.category_limit | default: 6 -%}
<section class="cham-section cham-section--paper cham-categories-section">
  <div class="cham-shell">
    <div class="cham-section-head">
      <div><p class="cham-kicker">{{ section.settings.eyebrow }}</p><h2 class="cham-section-title">{{ section.settings.heading }}</h2></div>
      <p class="cham-section-copy">{{ section.settings.body }}</p>
    </div>
    <div class="cham-category-grid">
      {% assign shown = 0 %}
      {% for collection in collections %}
        {% if collection.handle != 'frontpage' and shown < category_limit %}
          {% assign category_image = collection.image | default: collection.products.first.featured_image %}
          <a class="cham-category-card" href="{{ collection.url }}">
            {% if category_image != blank %}<span class="cham-category-card__media">{{ category_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240, 420, 700', sizes: '(max-width: 560px) 50vw, 16vw', alt: collection.title }}</span>{% endif %}
            <span class="cham-category-card__index">0{{ shown | plus: 1 }}</span>
            <span class="cham-category-card__text">{{ collection.title }}</span>
          </a>
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if shown == 0 %}
        {% assign labels = 'Giỏ & lưu trữ|Túi & phụ kiện|Khay & đồ bàn|Đèn & trang trí|Đồ dùng gia đình|Quà tặng đan' | split: '|' %}
        {% for label in labels %}
          <a class="cham-category-card" href="{{ routes.all_products_collection_url }}"><span class="cham-category-card__index">0{{ forloop.index }}</span><span class="cham-category-card__text">{{ label }}</span></a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CHẠM · Danh mục",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Dòng nhỏ","default":"KHÁM PHÁ THEO CÁCH DÙNG"},
    {"type":"text","id":"heading","label":"Tiêu đề","default":"Một kỹ thuật đan. Nhiều cách sống cùng nó."},
    {"type":"textarea","id":"body","label":"Mô tả","default":"CHẠM đi sâu vào đồ đan và tổ chức danh mục theo nhu cầu sử dụng để khách hàng tìm món phù hợp nhanh hơn."},
    {"type":"range","id":"category_limit","label":"Số danh mục","min":3,"max":12,"step":1,"default":6}
  ],
  "presets":[{"name":"CHẠM · Danh mục","category":"CHẠM"}]
}
{% endschema %}