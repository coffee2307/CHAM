<section class="cham-craft-categories" data-cham-scroll>
  <div class="cham-shell">
    <header class="cham-craft-categories__head">
      <div><p class="cham-craft-categories__eyebrow">Tuyển chọn dành cho bạn</p><h2>Khám phá theo danh mục</h2></div>
      <a href="{{ routes.all_products_collection_url }}" class="cham-craft-categories__all">Tất cả sản phẩm <span aria-hidden="true">→</span></a>
    </header>
    <div class="cham-craft-categories__grid">
      {% for group in collections %}
        {% unless group.handle == 'frontpage' or group.handle == 'all' %}
          {%- assign photo = group.image | default: group.products.first.featured_image -%}
          <a href="{{ group.url }}" class="cham-category-photo-card">
            <span class="cham-category-photo-card__photo">
              {% if photo != blank %}
                {{ photo | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300, 500, 750, 1000', sizes: '(max-width: 700px) 49vw, (max-width: 1100px) 46vw, 32vw', alt: group.title }}
              {% else %}
                <span class="cham-category-photo-card__fallback">CHẠM</span>
              {% endif %}
              <span class="cham-category-photo-card__arrow" aria-hidden="true">→</span>
            </span>
            <span class="cham-category-photo-card__caption"><strong>{{ group.title }}</strong><small>{{ group.products_count }} sản phẩm</small></span>
          </a>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"CHẠM · Danh mục","tag":"section","settings":[],"presets":[{"name":"CHẠM · Danh mục","category":"CHẠM"}]}
{% endschema %}
