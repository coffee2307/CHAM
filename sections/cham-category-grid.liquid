<section class="cham-section cham-categories-section" data-cham-scroll>
  <div class="cham-shell">
    <div class="cham-section-head">
      <div><h2 class="cham-section-title">Khám phá theo danh mục</h2></div>
      <a class="cham-more-link" href="{{ routes.all_products_collection_url }}">Tất cả sản phẩm</a>
    </div>
    <div class="cham-category-grid cham-category-grid--clean">
      {% for group in collections %}
        {% unless group.handle == 'frontpage' or group.handle == 'all' %}
          {% assign category_image = group.image | default: group.products.first.featured_image %}
          <a class="cham-category-card" href="{{ group.url }}">
            <span class="cham-category-card__media">
              {% if category_image != blank %}
                {{ category_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240, 420, 700', sizes: '(max-width: 600px) 42vw, 17vw', alt: group.title }}
              {% else %}
                <span class="cham-category-card__fallback">CHẠM</span>
              {% endif %}
            </span>
            <span class="cham-category-card__text">{{ group.title }}</span>
          </a>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"CHẠM · Danh mục","tag":"section","settings":[],"presets":[{"name":"CHẠM · Danh mục","category":"CHẠM"}]}
{% endschema %}