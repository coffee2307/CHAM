{%- liquid
  assign banner_handles = 'học-sinh-sinh-vien,dồ-dung-một-lần,xo-dua,gom,tre-may,luc-binh-co,go-soi-tu-nhien,qua-tặng-dưới-100-000d,bản-sắc-việt-nam,qua-tặng-cuối-nam' | split: ','
  assign banner_keys = 'study,disposable,coir,ceramic,bamboo,grass,wood,gifts,vietnam,yearend' | split: ','
  assign banner_titles = 'Học tập mỗi ngày|Tiện dụng mỗi ngày|Từ sợi xơ dừa|Vẻ đẹp của gốm|Tre và mây|Lục bình và cỏ|Gỗ và sợi tự nhiên|Quà nhỏ dưới 100.000đ|Một nét Việt Nam|Quà tặng cuối năm' | split: '|'
  assign banner_descriptions = 'Đồ dùng học tập từ chất liệu gần gũi.|Ống hút, đĩa và vật dụng từ thiên nhiên.|Những món đồ nhỏ cho nhà cửa và sinh hoạt.|Một góc nhà ấm áp với đồ gốm.|Đan lát mộc mạc cho không gian sống.|Sợi đan tự nhiên trong từng vật dụng.|Chạm vào vẻ đẹp của những đường vân.|Những lựa chọn giản dị để dành tặng.|Nón lá và những họa tiết thân quen.|Gửi lời cảm ơn qua những món quà nhỏ.' | split: '|'
-%}
<div class="cham-banner cham-banner--{{ variant | default: 'compact' }}" data-cham-banner data-interval="{% if variant == 'home' %}6500{% else %}5000{% endif %}" role="region" aria-roledescription="băng chuyền" aria-label="Bộ sưu tập nổi bật">
  <div class="cham-banner__viewport" data-banner-viewport>
    <div class="cham-banner__track" data-banner-track>
      {% for handle in banner_handles %}
        {% assign group = collections[handle] %}
        {% if group != blank %}
          {% assign idx = forloop.index0 %}
          {% assign banner_file = 'cham-banner-' | append: banner_keys[idx] | append: '.webp' %}
          <article class="cham-banner__slide" data-banner-slide data-tone="{{ banner_keys[idx] }}" aria-roledescription="slide" aria-label="{{ group.title | escape }}" {% unless forloop.first %}inert aria-hidden="true"{% endunless %}>
            <a class="cham-banner__link" href="{{ group.url }}" aria-label="Xem bộ sưu tập {{ group.title | escape }}">
              <div class="cham-banner__copy">
                <span class="cham-banner__category">{{ group.title | escape }}</span>
                <h2>{{ banner_titles[idx] | escape }}</h2>
                <p>{{ banner_descriptions[idx] | escape }}</p>
                <span class="cham-banner__cta">Xem bộ sưu tập</span>
              </div>
              <div class="cham-banner__image">
                <img {% if forloop.first %}src="{{ banner_file | asset_url }}" loading="lazy"{% else %}data-src="{{ banner_file | asset_url }}"{% endif %} width="1200" height="680" decoding="async" alt="" data-banner-image>
              </div>
            </a>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="cham-banner__controls" data-banner-controls hidden>
    <button class="cham-banner__arrow" type="button" data-banner-prev aria-label="Bộ sưu tập trước"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 6-6 6 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <div class="cham-banner__dots" data-banner-dots aria-label="Chọn bộ sưu tập"></div>
    <button class="cham-banner__arrow" type="button" data-banner-next aria-label="Bộ sưu tập tiếp theo"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <button class="cham-banner__pause" type="button" data-banner-pause aria-label="Tạm dừng tự chuyển" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path data-banner-pause-icon d="M9 6v12M15 6v12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
  </div>
</div>
