{%- liquid
  assign seo_title = page_title | default: shop.name | strip
  assign seo_description = page_description | default: shop.description | strip_html | strip
  assign og_title = seo_title
  assign og_description = seo_description
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<link rel="canonical" href="{{ canonical_url }}">
<meta name="application-name" content="{{ shop.name | escape }}">
<meta name="author" content="{{ shop.name | escape }}">
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{% if og_description != blank %}<meta property="og:description" content="{{ og_description | escape }}">{% endif %}
{% if page_image %}
  <meta property="og:image" content="http:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{% endif %}
{% if request.page_type == 'product' %}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{% endif %}
<meta name="twitter:card" content="{% if page_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
{% if og_description != blank %}<meta name="twitter:description" content="{{ og_description | escape }}">{% endif %}
{% if page_image %}<meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
<title>{{ seo_title | escape }}{% if current_page != 1 %} — Trang {{ current_page }}{% endif %}{% unless seo_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
{% if seo_description != blank %}<meta name="description" content="{{ seo_description | escape }}">{% endif %}
