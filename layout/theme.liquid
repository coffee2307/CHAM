<!doctype html>
<html lang="{{ request.locale.iso_code }}" {% if request.design_mode %}class="shopify-design-mode"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link rel="expect" href="#MainContent" blocking="render" id="view-transition-render-blocker">
    {% endif %}
    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}
    {{ 'cham-theme.css' | asset_url | stylesheet_tag }}
    {{ 'cham-refinement.css' | asset_url | stylesheet_tag }}
    {{ 'cham-demo.css' | asset_url | stylesheet_tag }}
    {{ 'cham-minimal.css' | asset_url | stylesheet_tag }}
    {{ 'cham-polish.css' | asset_url | stylesheet_tag }}
    {{ 'cham-v3.css' | asset_url | stylesheet_tag }}
    {% if template.suffix == 'cham-play' %}
      {{ 'cham-quest.css' | asset_url | stylesheet_tag }}
    {% elsif template.suffix == 'cham-club' %}
      {{ 'cham-club-v3.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {{ 'cham-v4.css' | asset_url | stylesheet_tag }}
    {% if template.name == 'index' %}
      {{ 'cham6-phudu.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
      {{ 'cham5-home.css' | asset_url | stylesheet_tag }}
      {{ 'cham7-home.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'cham-gsap.min.js' | asset_url }}" defer></script>
      <script src="{{ 'cham-scrolltrigger.min.js' | asset_url }}" defer></script>
      <script src="{{ 'cham-lenis.min.js' | asset_url }}" defer></script>
      <script src="{{ 'cham5-home.js' | asset_url }}" defer></script>
      <script src="{{ 'cham7-weave.js' | asset_url }}" defer></script>
      <script src="{{ 'cham7-editorial.js' | asset_url }}" defer></script>
    {% endif %}
    <script src="{{ 'cham-demo-core.js' | asset_url }}" defer></script>
    {% if template.suffix == 'cham-play' %}
      <script src="{{ 'cham-craft-knowledge.js' | asset_url }}" defer></script>
      <script src="{{ 'cham-quest.js' | asset_url }}" defer></script>
    {% elsif template.suffix == 'cham-club' %}
      <script src="{{ 'cham-club-v3.js' | asset_url }}" defer></script>
    {% endif %}
    <script src="{{ 'cham-demo-pages.js' | asset_url }}" defer></script>
    <script src="{{ 'cham-v3.js' | asset_url }}" defer></script>
    <script src="{{ 'cham-theme.js' | asset_url }}" defer></script>
    <script src="{{ 'cham-mobile-menu.js' | asset_url }}" defer></script>
    <script src="{{ 'cham-shop.js' | asset_url }}" defer></script>
    {% if request.design_mode %}{%- render 'theme-editor' -%}{% endif %}
    {{ content_for_header }}
  </head>
  <body class="cham-site page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}{% if template.suffix == 'cham-play' %} cham-play-mode{% endif %}{% if template.name == 'index' %} cham5-home{% endif %}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'Bỏ qua đến nội dung chính', literal: true %}
    <div id="header-group">{% sections 'header-group' %}</div>
    <main id="MainContent" class="content-for-layout" role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}">
      {{ content_for_layout }}
    </main>
    <footer>{% sections 'footer-group' %}</footer>
  </body>
</html>